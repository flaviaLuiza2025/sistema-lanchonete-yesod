<style>
    body {
        background-color: #faf8f5;
        font-size: 16px;
        color: #2c2c2c;
    }

    h1 {
        color: #bf360c;
        font-weight: bold;
    }

    h3 {
        color: #4e342e;
        margin-top: 24px;
    }

    /* Estilo dos formulários de cadastro (.form-crud) */
    .form-crud {
        background-color: #fff3e0;
        border: 1px solid #ffcc80;
        border-left: 6px solid #e65100;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
        font-size: 17px;
        line-height: 2.2;
    }

    .form-crud input[type="text"],
    .form-crud input[type="number"],
    .form-crud select {
        font-size: 16px;
        padding: 6px 10px;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
        background-color: #ffffff;
        margin-right: 12px;
    }

    .form-crud button {
        font-size: 16px;
        padding: 8px 16px;
        font-weight: bold;
    }

    /* Fonte maior nas tabelas */
    .table {
        background-color: #ffffff;
        font-size: 16px;
    }
</style>

<!-- Static navbar -->
<nav .navbar.navbar-default.navbar-static-top>
    <div .container>
        <div .navbar-header>
            <button type="button" .navbar-toggle.collapsed data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                <span class="sr-only">Toggle navigation
                <span class="icon-bar">
                <span class="icon-bar">
                <span class="icon-bar">

        <div #navbar .collapse.navbar-collapse>
            <ul .nav.navbar-nav>
                $forall MenuItem label route _ <- navbarLeftFilteredMenuItems
                    <li :Just route == mcurrentRoute:.active>
                        <a href="@{route}">#{label}

            <ul .nav.navbar-nav.navbar-right>
                $forall MenuItem label route _ <- navbarRightFilteredMenuItems
                    <li :Just route == mcurrentRoute:.active>
                        <a href="@{route}">#{label}

<!-- Page Contents -->

<div .container>
    $if not $ Just HomeR == mcurrentRoute
        <ul .breadcrumb>
            $forall bc <- parents
                <li>
                    <a href="@{fst bc}">#{snd bc}

            <li .active>#{title}

    $maybe msg <- mmsg
      <div .alert.alert-info #message>#{msg}


$if (Just HomeR == mcurrentRoute)
    ^{widget}
$else
    <div .container>
        <div .row>
            <div .col-md-12>
                ^{widget}
